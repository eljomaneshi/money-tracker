generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                          Int      @id @default(autoincrement())
  email                       String   @unique
  passwordHash                String
  fullName                    String?
  totalsMainCurrency          String   @default("ALL")
  showSecondCurrency          Boolean  @default(true)
  secondCurrency              String?  @default("EUR")
  notifySubscriptionReminder  Boolean  @default(true)
  notifySubscriptionCreated   Boolean  @default(true)
  notifySubscriptionCancelled Boolean  @default(true)
  createdAt                   DateTime @default(now())

  subscriptions       Subscription[]
  expenses            Expense[]
  accounts            Account[]
  pendingEmailChanges PendingEmailChange[]
  accountActions      AccountAction[]
  notes               Note[]
}

model EmailVerificationCode {
  id        Int      @id @default(autoincrement())
  email     String
  codeHash  String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model PendingEmailChange {
  id        Int      @id @default(autoincrement())
  userId    Int
  newEmail  String
  codeHash  String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([newEmail])
}

model Expense {
  id          Int      @id @default(autoincrement())
  amount      Float
  date        DateTime
  category    String
  description String?
  userId      Int
  accountId   Int?
  createdAt   DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

enum AccountType {
  BANK
  CASH
  CRYPTO
  OTHER
}

enum Currency {
  ALL
  EUR
  GBP
  USD
}

enum AccountActionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_OUT
  TRANSFER_IN
}

enum NoteType {
  GENERAL
  TO_RECEIVE
  TO_PAY
  REMINDER
}

enum NoteStatus {
  OPEN
  DONE
  CANCELLED
}

enum RepeatPeriod {
  NONE
  MONTHLY
  YEARLY
}

model Subscription {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String
  price           Float
  billingPeriod   String
  nextBillingDate DateTime
  status          String

  accountId Int?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  reminder3DaysSentFor DateTime?
  reminder1DaySentFor  DateTime?

  createdAt DateTime @default(now())
}

model Account {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  type         AccountType
  balance      Float
  baseCurrency Currency    @default(EUR)

  expenses        Expense[]
  subscriptions   Subscription[]
  outgoingActions AccountAction[] @relation("ActionFromAccount")
  incomingActions AccountAction[] @relation("ActionToAccount")

  createdAt DateTime @default(now())
}

model AccountAction {
  id           Int               @id @default(autoincrement())
  userId       Int
  accountId    Int
  toAccountId  Int?
  type         AccountActionType
  amount       Float
  targetAmount Float?
  exchangeRate Float?
  description  String?
  date         DateTime
  createdAt    DateTime          @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account  @relation("ActionFromAccount", fields: [accountId], references: [id], onDelete: Cascade)
  toAccount Account? @relation("ActionToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([accountId])
  @@index([toAccountId])
}

model Note {
  id           Int          @id @default(autoincrement())
  userId       Int
  title        String
  description  String?      @db.Text
  amount       Float?
  currency     Currency     @default(EUR)
  personName   String?
  dueDate      DateTime?
  repeatPeriod RepeatPeriod @default(NONE)
  type         NoteType     @default(GENERAL)
  status       NoteStatus   @default(OPEN)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, dueDate])
}
