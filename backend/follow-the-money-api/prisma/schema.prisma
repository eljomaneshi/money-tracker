generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                          Int                  @id @default(autoincrement())
  email                       String               @unique
  passwordHash                String
  createdAt                   DateTime             @default(now())
  fullName                    String?
  notifySubscriptionCancelled Boolean              @default(true)
  notifySubscriptionCreated   Boolean              @default(true)
  notifySubscriptionReminder  Boolean              @default(true)
  secondCurrency              String?              @default("EUR")
  showSecondCurrency          Boolean              @default(true)
  totalsMainCurrency          String               @default("ALL")
  accounts                    Account[]
  AccountAction               AccountAction[]
  expenses                    Expense[]
  notes                       Note[]
  PendingEmailChange          PendingEmailChange[]
  subscriptions               Subscription[]
}

model Account {
  id           Int                  @id @default(autoincrement())
  userId       Int
  name         String
  type         Account_type
  balance      Float
  createdAt    DateTime             @default(now())
  baseCurrency Account_baseCurrency @default(EUR)
  sortOrder    Int                  @default(0)
  deletedAt    DateTime?

  user                                             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  AccountAction_AccountAction_accountIdToAccount   AccountAction[] @relation("AccountAction_accountIdToAccount")
  AccountAction_AccountAction_toAccountIdToAccount AccountAction[] @relation("AccountAction_toAccountIdToAccount")
  expenses                                         Expense[]
  subscriptions                                    Subscription[]

  @@index([userId], map: "Account_userId_fkey")
  @@index([userId, deletedAt])
}

model Expense {
  id          Int      @id @default(autoincrement())
  userId      Int
  amount      Float
  date        DateTime
  category    String
  description String?
  createdAt   DateTime @default(now())
  accountId   Int?
  account     Account? @relation(fields: [accountId], references: [id])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountId], map: "Expense_accountId_fkey")
  @@index([userId], map: "Expense_userId_fkey")
}

model Subscription {
  id                   Int       @id @default(autoincrement())
  name                 String
  price                Float
  billingPeriod        String
  nextBillingDate      DateTime
  status               String
  createdAt            DateTime  @default(now())
  userId               Int
  accountId            Int?
  reminder1DaySentFor  DateTime?
  reminder3DaysSentFor DateTime?
  account              Account?  @relation(fields: [accountId], references: [id])
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountId], map: "Subscription_accountId_fkey")
  @@index([userId], map: "Subscription_userId_fkey")
}

model Note {
  id           Int               @id @default(autoincrement())
  userId       Int
  title        String
  description  String?           @db.Text
  amount       Float?
  personName   String?
  dueDate      DateTime?
  repeatPeriod Note_repeatPeriod @default(NONE)
  type         Note_type         @default(GENERAL)
  status       Note_status       @default(OPEN)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  currency     Note_currency     @default(EUR)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
  @@index([userId, status])
}

model AccountAction {
  id           Int                @id @default(autoincrement())
  userId       Int
  accountId    Int
  toAccountId  Int?
  type         AccountAction_type
  amount       Float
  description  String?
  date         DateTime
  createdAt    DateTime           @default(now())
  exchangeRate Float?
  targetAmount Float?
  account      Account            @relation("AccountAction_accountIdToAccount", fields: [accountId], references: [id], onDelete: Cascade)
  toAccount    Account?           @relation("AccountAction_toAccountIdToAccount", fields: [toAccountId], references: [id])
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([toAccountId])
  @@index([userId, date])
}

model EmailVerificationCode {
  id        Int      @id @default(autoincrement())
  email     String
  codeHash  String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model PendingEmailChange {
  id        Int      @id @default(autoincrement())
  userId    Int
  newEmail  String
  codeHash  String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([newEmail])
  @@index([userId])
}

enum Account_type {
  BANK
  CASH
  CRYPTO
  OTHER
}

enum AccountAction_type {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_OUT
  TRANSFER_IN
}

enum Account_baseCurrency {
  ALL
  EUR
  GBP
  USD
}

enum Note_repeatPeriod {
  NONE
  MONTHLY
  YEARLY
}

enum Note_type {
  GENERAL
  TO_RECEIVE
  TO_PAY
  REMINDER
}

enum Note_status {
  OPEN
  DONE
  CANCELLED
}

enum Note_currency {
  ALL
  EUR
  GBP
  USD
}
