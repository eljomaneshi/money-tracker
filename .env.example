# Money Tracker - Global Environment Configuration Example
# Copy to backend/follow-the-money-api/.env or frontend/.env respectively

# ==========================================
# Backend Configuration (follow-the-money-api)
# ==========================================
PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Local development default (Docker):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/money_tracker?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/money_tracker?schema=public

# Authentication
JWT_SECRET=replace_with_a_long_random_secret

# Email Service (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
EMAIL_FROM=you@example.com
EMAIL_PORT=587
EMAIL_SECURE=false

# Allowed Frontend Origin
FRONTEND_URL=http://localhost:5173

# ==========================================
# Frontend Configuration (frontend)
# ==========================================
VITE_API_URL=http://localhost:4000
